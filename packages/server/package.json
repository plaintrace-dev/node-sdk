{
  "name": "@plaintrace/server",
  "version": "0.1.0",
  "description": "Plaintrace for your server: first-party proxy, crawler reads, measured loss and server-side events.",
  "keywords": [
    "analytics",
    "web-analytics",
    "cookieless",
    "privacy",
    "server-side",
    "proxy",
    "crawlers",
    "plaintrace"
  ],
  "license": "MIT",
  "author": "VALUNLABS LLC (https://plaintrace.dev)",
  "homepage": "https://plaintrace.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plaintrace-dev/node-sdk.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/plaintrace-dev/node-sdk/issues",
    "email": "hello@plaintrace.dev"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
